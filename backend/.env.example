# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (MUST BE A REPLICA SET FOR TRANSACTIONS)
MONGO_URI=mongodb://localhost:27017/hotel_booking?replicaSet=rs0

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key

# Cloudinary Storage Configuration
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@smartbooking.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

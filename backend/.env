# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration (MUST BE A REPLICA SET FOR TRANSACTIONS)
MONGO_URI=mongodb://localhost:27017/hotel_booking

# JWT Secrets (dummy values for local development)
JWT_SECRET=your_super_secret_jwt_access_key_local_dev
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_local_dev

# Cloudinary Storage Configuration (dummy - will fail uploads)
CLOUDINARY_URL=cloudinary://dummy:dummy@dummy

# Email / SMTP Configuration (dummy - will fail email)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy
SMTP_PASS=dummy
EMAIL_FROM=noreply@smartbooking.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
